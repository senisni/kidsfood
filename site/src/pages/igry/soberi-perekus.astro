---
// Игра «Собери перекус». Перекус как маленькая тарелка: фрукт или овощ, ещё один друг и попить.
// Общая сцена, шрифты, звук, перетаскивание и подсказки — в GameLayout; здесь только эта игра.
import GameLayout from '@/page-components/GamePage/GameLayout.astro'
import { gameBySlug } from '@/data/games'
---

<GameLayout game={gameBySlug('soberi-perekus')}>
  <div class="top">
    <a class="btn ghost" href="/igry/">← Все игры</a>
    <div class="card task" style="--back:#e8b8cc"><div class="num">?</div><div>Собери перекус: <b>фрукт или овощ + ещё один друг</b>. И попить.</div></div>
    <div class="round" id="round">1 из 4</div>
    <button class="btn ghost" id="reset">Заново</button>
  </div>
  <div class="card sit"><div class="when" id="when"></div><div class="txt2" id="sit"></div>
    <div class="rule"><b>Перекус</b> — маленькая тарелка, чтобы дожить до обеда или ужина.</div><img id="hero"></div>
  <div class="zone" id="plateZ"><div class="zl">Тарелочка</div><img class="pl" src="/video/sprites/plate3-1.png">
    <div class="slots"><div id="sF" style="--c:var(--veg)">фрукт или овощ</div><div id="sP" style="--c:var(--prot)">ещё один друг</div></div></div>
  <div class="zone" id="drinkZ"><div class="zl">Попить</div><div class="slots"><div id="sD" style="--c:var(--water)">напиток</div></div></div>
  <div class="say"><div class="face"></div><div class="txt"></div></div>
  <div class="shelf"><div class="lbl">кухня</div></div>
  <div class="win"><div class="card" style="--back:#e8b8cc"></div></div>

  <Fragment slot="script">
    <script is:inline>
      // kind: f — фрукт/овощ, p — белок или хлеб (второй друг), s — сладкое, d — напиток (good: вода)
      const ITEMS = {
        apple: { img: "el10-3", name: "яблоко", kind: "f" }, banana: { img: "el20-1", name: "банан", kind: "f" },
        sticks: { img: "snack-4", name: "овощи палочки", kind: "f" }, berries: { img: "snack-5", name: "ягоды", kind: "f" },
        sandC: { img: "snack-1", name: "бутерброд сыр", kind: "p" }, sandE: { img: "snack-2", name: "бутерброд яйцо", kind: "p" },
        yogurt: { img: "snack-3", name: "йогурт", kind: "p" },
        cookies: { img: "snack-6", name: "печенье", kind: "s" }, candy: { img: "snack-7", name: "конфета", kind: "s" },
        water: { img: "el10-6", name: "вода", kind: "d", good: true }, juice: { img: "snack-9", name: "сок", kind: "d" }, soda: { img: "snack-10", name: "газировка", kind: "d" },
      };
      const SIT = [
        { when: "После школы", hero: "boyact-5", who: "boy", sit: "Уроки кончились, до обеда дома ещё час. Живот урчит." },
        { when: "На прогулку", hero: "girlact-1", who: "girl", sit: "Идём в парк на два часа. Что взять с собой?" },
        { when: "Перед тренировкой", hero: "boyact-3", who: "boy", sit: "Через час футбол. Нужно немного сил, но не тяжело." },
        { when: "Вечером", hero: "girlact-3", who: "girl", sit: "До ужина полтора часа, а есть хочется уже сейчас.", noNuts: false },
      ];
      const PZ = { x: 490, y: 140, w: 640, h: 420 }, DZ = { x: 1170, y: 140, w: 396, h: 420 };
      const inZ = (p, z) => p.x > z.x && p.x < z.x + z.w && p.y > z.y && p.y < z.y + z.h;
      let R = 0, st;
      function start(r) {
        R = r; const s = SIT[r];
        hideWin(); stage.querySelectorAll(".item").forEach(e => e.remove());
        st = { f: null, p: null, d: null, wrong: 0 };
        $("#round").textContent = `${r + 1} из ${SIT.length}`;
        $("#when").textContent = s.when; $("#sit").textContent = s.sit; $("#hero").src = S(s.hero);
        ["sF", "sP", "sD"].forEach(id => $("#" + id).classList.remove("on"));
        fillShelf(stage, shuffle(Object.entries(ITEMS)).map(([k, v]) => ({ ...v, key: k })), (el, it) => draggable(el, {
          onMove: (el, p) => { $("#plateZ").classList.toggle("hot", inZ(p, PZ)); $("#drinkZ").classList.toggle("hot", inZ(p, DZ)); },
          onDrop: (el, p) => drop(el, it, p),
        }));
        say(s.sit + " Собери перекус!", s.who);
      }
      function put(el, x, y) { el.classList.add("back", "placed"); el.dataset.lock = 1; el.style.left = x + "px"; el.style.top = y + "px"; }
      function drop(el, it, p) {
        $("#plateZ").classList.remove("hot"); $("#drinkZ").classList.remove("hot");
        const who = SIT[R].who, onP = inZ(p, PZ), onD = inZ(p, DZ);
        if (!onP && !onD) return false;
        const bad = msg => { st.wrong++; bounceBack(el); say(msg, who, "bad"); return true; };
        if (onD) {
          if (it.kind !== "d") return bad(`${cap(it.name)} — это еда. Ей место на тарелочке.`);
          if (!it.good) return bad(`${cap(it.name)} — сладкий напиток, это иногда. Когда хочется пить, лучше вода.`);
          if (st.d) return bad("Попить уже есть.");
          st.d = it; put(el, DZ.x + DZ.w / 2 - 59, DZ.y + 130); $("#sD").classList.add("on");
          sfx.plop(); sfx.check(); say("Вода — лучший выбор, когда хочется пить!", who, "good"); return check();
        }
        // тарелочка
        if (it.kind === "d") return bad(`${cap(it.name)} — это напиток. Поставь справа.`);
        if (it.kind === "s") return bad(`${cap(it.name)} — сладкое, иногда можно. Но перекус из него быстро кончится. Нужен фрукт или овощ и ещё один друг.`);
        if (it.kind === "f") {
          if (st.f) return bad("Фрукт или овощ уже есть. Теперь нужен ещё один друг: йогурт или бутерброд.");
          st.f = it; put(el, PZ.x + 205, PZ.y + 150); $("#sF").classList.add("on");
        } else {
          if (st.p) return bad("Второй друг уже есть. А фрукт или овощ?");
          st.p = it; put(el, PZ.x + 330, PZ.y + 120); $("#sP").classList.add("on");
        }
        sfx.plop(); sfx.check(); say(`Да: ${it.name}!`, who, "good");
        return check();
      }
      function check() {
        if (st.f && st.p && st.d) {
          sfx.win(); store.set("snack-" + R, true);
          const last = R === SIT.length - 1;
          setTimeout(() => showWin(`<h2>Перекус готов!</h2>
            <div class="row">${[st.f, st.p, st.d].map(i => `<img src="${S(i.img)}">`).join("")}</div>
            <p>${cap(st.f.name)} + ${st.p.name} и вода: маленькая тарелка из друзей. Сил хватит до следующей еды.</p>
            <p class="stars">${st.wrong ? `Подсказок: ${st.wrong}` : "Без единой подсказки!"}</p>
            ${last ? `<a class="btn green" href="/igry/">В меню</a>` : `<button class="btn green" onclick="start(${R + 1})">Следующая ситуация →</button>`}`), 700);
        }
        return true;
      }
      $("#reset").onclick = () => start(R);
      start(0);
    </script>
  </Fragment>
</GameLayout>

<style is:global>
  .sit { left: 30px; top: 120px; width: 420px; height: 464px; padding: 20px 24px; --back: #e8b8cc; }
  .sit .when { font-family: Balsamiq; font-size: 26px; color: var(--prot); }
  .sit .txt2 { font-size: 27px; font-weight: 800; line-height: 1.2; margin-top: 6px; }
  .sit img { position: absolute; right: 10px; bottom: 0; height: 220px; }
  .rule { max-width: 230px; }
  .rule { margin-top: 14px; font-size: 21px; line-height: 1.3; }
  .rule b { font-family: Balsamiq; }
  .zone { position: absolute; top: 140px; height: 420px; border-radius: 24px; border: 6px dashed rgba(60,40,10,.22); transition: background .2s, border-color .2s; }
  .zone.hot { background: rgba(255,255,255,.45); border-color: var(--veg); }
  .zone .zl { position: absolute; left: 50%; top: -22px; transform: translateX(-50%); white-space: nowrap; font-family: Balsamiq; font-size: 26px; background: var(--paper); padding: 4px 16px; border-radius: 12px; box-shadow: var(--shadow); }
  #plateZ { left: 490px; width: 640px; }
  #plateZ img.pl { position: absolute; left: 50%; top: 50%; width: 380px; transform: translate(-50%, -50%); opacity: .95; filter: drop-shadow(6px 10px 8px rgba(60,40,10,.25)); }
  #drinkZ { left: 1170px; width: 396px; }
  .slots { position: absolute; left: 22px; right: 22px; bottom: 16px; display: flex; gap: 10px; justify-content: center; }
  .slots div { font-size: 19px; font-weight: 800; padding: 4px 10px; border-radius: 10px; background: var(--paper); border: 3px solid var(--c); }
  .slots div.on { background: var(--c); color: var(--paper); }
  .item span { font-size: 16px; padding: 2px 6px; }
</style>
