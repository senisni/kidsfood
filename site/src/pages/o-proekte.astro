---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import ParentsSection from '@/page-components/HomePage/ParentsSection.astro'
import { facts, sources } from '@/data/facts'
import { breadcrumbSchema, faqSchema } from '@/lib/seo'
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'О проекте', href: '/o-proekte/' }]
---
<BaseLayout title="О проекте «Три друга на тарелке» — родителям и учителям" description="Как смотреть мультфильмы и играть с детьми 8–12 лет. Принципы проекта: разнообразная еда, интерес к продуктам, внимание к сытости. Источники и ответы на вопросы." schema={[breadcrumbSchema(crumbs), faqSchema(facts)]}>
  <PageHero background="garden-autumn" fill="bg-skyline" position="object-bottom" crumbs={crumbs} kicker="О проекте" title="О проекте «Три друга на тарелке»" lead="Истории в стиле бумажного коллажа, семь игр и семейное меню. Помогаем детям 8–12 лет замечать разнообразие еды через знакомые ситуации: завтрак, школьный обед, перекус и ужин." image="girl-waving" imageAlt="Девочка с яблоком машет рукой" class="pb-[3rem] sm:pb-[4rem]" />
  <ParentsSection full />
  <section class="shell py-[2.6rem] pb-[3.4rem]"><div class="grid gap-[2rem] sm:grid-cols-2"><div><h2 class="leading-[1em] font-display text-[1.6rem] font-black text-forest-deep">Как заниматься вместе</h2><ol class="mt-[0.8rem] list-decimal space-y-[0.6rem] pl-[1.2rem] text-[1.05rem]"><li>Посмотрите <a href="/multfilmy/film/" class="text-forest underline underline-offset-4">основной мультфильм</a>. Можно делать паузы и отвечать на вопросы.</li><li>Выберите <a href="/igry/" class="text-forest underline underline-offset-4">игру по теме</a>. Дайте ребёнку попробовать самому.</li><li>Откройте <a href="/menu/" class="text-forest underline underline-offset-4">семейное меню</a> и найдите знакомые продукты в настоящем блюде.</li></ol></div><div id="sources" class="scroll-mt-[5rem]"><h2 class="leading-[1em] font-display text-[1.6rem] font-black text-forest-deep">Источники и границы проекта</h2><p class="mt-[0.8rem] ">Объяснения опираются на рекомендации о разнообразном питании и подход к кормлению без давления. Материалы предназначены для знакомства с едой и не составляют индивидуальный рацион. Особые потребности и пищевые аллергии обсуждают со специалистом.</p><ul class="mt-[0.8rem] space-y-[0.5rem]">{sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener noreferrer" class="font-bold text-water underline underline-offset-4">{source.name} ↗</a></li>)}</ul></div></div></section>
</BaseLayout>
