---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import ParentsSection from '@/page-components/HomePage/ParentsSection.astro'
import { facts, sources } from '@/data/facts'
import { breadcrumbSchema } from '@/lib/seo'
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'О проекте', href: '/o-proekte/' }]
---
<BaseLayout title="О проекте «Три друга на тарелке» — родителям и учителям" description="Как смотреть мультфильмы и играть с детьми 8–12 лет. Принципы проекта: разнообразная еда, интерес к продуктам, внимание к сытости. Источники и ответы на вопросы." schema={[breadcrumbSchema(crumbs), { '@type': 'FAQPage', mainEntity: facts.map((fact) => ({ '@type': 'Question', name: fact.title, acceptedAnswer: { '@type': 'Answer', text: fact.text } })) }]}>
  <section class="mx-auto max-w-7xl px-5 pt-10 md:px-8"><Breadcrumbs items={crumbs} /><h1 class="max-w-3xl font-display text-4xl leading-tight font-bold md:text-5xl">О проекте «Три друга на тарелке»</h1><p class="mt-5 max-w-3xl text-xl leading-relaxed">Истории в стиле бумажного коллажа, семь игр и семейное меню. Помогаем детям 8–12 лет замечать разнообразие еды через знакомые ситуации: завтрак, школьный обед, перекус и ужин.</p></section>
  <ParentsSection full />
  <section class="mx-auto max-w-7xl px-5 pb-12 md:px-8"><div class="grid gap-8 border-t border-ink/15 pt-8 md:grid-cols-2"><div><h2 class="font-display text-2xl font-bold">Как заниматься вместе</h2><ol class="mt-4 list-decimal space-y-3 pl-5 text-lg"><li>Посмотрите <a href="/multfilmy/film/" class="text-forest underline underline-offset-4">основной мультфильм</a>. Можно делать паузы и отвечать на вопросы.</li><li>Выберите <a href="/igry/" class="text-forest underline underline-offset-4">игру по теме</a>. Дайте ребёнку попробовать самому.</li><li>Откройте <a href="/menu/" class="text-forest underline underline-offset-4">семейное меню</a> и найдите знакомые продукты в настоящем блюде.</li></ol></div><div id="sources" class="scroll-mt-24"><h2 class="font-display text-2xl font-bold">Источники и границы проекта</h2><p class="mt-4 leading-relaxed">Объяснения опираются на рекомендации о разнообразном питании и подход к кормлению без давления. Материалы предназначены для знакомства с едой и не составляют индивидуальный рацион. Особые потребности и пищевые аллергии обсуждают со специалистом.</p><ul class="mt-4 space-y-3">{sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener noreferrer" class="font-bold text-water underline underline-offset-4">{source.name} ↗</a></li>)}</ul></div></div></section>
</BaseLayout>
