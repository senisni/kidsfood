---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CinemaSection from '@/page-components/HomePage/CinemaSection.astro'
import GamesSection from '@/page-components/HomePage/GamesSection.astro'
import HeroSection from '@/page-components/HomePage/HeroSection.astro'
import KitchenSection from '@/page-components/HomePage/KitchenSection.astro'
import ParentsSection from '@/page-components/HomePage/ParentsSection.astro'
import PlateSection from '@/page-components/HomePage/PlateSection.astro'
import { homeFacts } from '@/data/facts'
import { videos } from '@/data/videos'
import { absoluteUrl, faqSchema, videoSchema } from '@/lib/seo'

const schema = [
  faqSchema(homeFacts),
  { '@type': 'ItemList', name: 'Мультфильмы о еде для детей', itemListElement: videos.map((video, index) => ({ '@type': 'ListItem', position: index + 1, url: absoluteUrl(`/multfilmy/${video.id}/`), item: videoSchema(video) })) },
]
---

<BaseLayout title="Как объяснить детям пользу еды: мультфильмы и игры | Три друга" description="Бесплатные мультфильмы и 7 игр о еде для детей 8–12 лет: из чего собрать тарелку, зачем клетчатка, как понять, что наелся. Семейное меню на 45 блюд и памятка для родителей." schema={schema}>
  <HeroSection />
  <PlateSection />
  <CinemaSection />
  <GamesSection />
  <KitchenSection />
  <ParentsSection />
</BaseLayout>
