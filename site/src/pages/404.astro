---
import Button from '@/components/Button.astro'
import Plate from '@/components/Plate.astro'
import SpeechBubble from '@/components/SpeechBubble.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { phrases } from '@/data/phrases'
---

<BaseLayout title="Страница не найдена — Три друга на тарелке" description="Такой страницы нет. Вернитесь на главную." noindex>
  <section class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 py-20 text-center">
    <Plate tint={false} class="w-60" />
    <h1 class="font-display text-5xl font-bold">Тарелка пустая</h1>
    <SpeechBubble phrase={phrases.question} face tail="left" />
    <p class="text-xl">Такой страницы нет. Зато на главной — мультфильмы и игры.</p>
    <Button href="/" variant="green">На главную</Button>
  </section>
</BaseLayout>
