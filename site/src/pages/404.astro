---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Button from '@/components/Button.astro'
import KitImage from '@/components/KitImage.astro'
import Scene from '@/components/Scene.astro'
import SpeechBubble from '@/components/SpeechBubble.astro'
import { phrases } from '@/data/phrases'
---

<BaseLayout title="Страница не найдена — Три друга на тарелке" description="Такой страницы нет. Вернитесь на главную." noindex>
  <Scene background="garden-winter" fill="bg-skyline" position="object-bottom" eager class="py-[3rem] sm:py-[4rem]">
    <div class="shell grid items-center gap-[1.5rem] sm:grid-cols-[1.3fr_1fr]">
      <div>
        <h1 class="font-display text-[3rem] leading-[1] font-black text-forest-deep sm:text-[4rem]">Тарелка пустая</h1>
        <p class="mt-[0.8rem] max-w-[28rem] text-[1.15rem] font-bold text-forest-deep">Такой страницы нет. Зато на главной — мультфильмы и игры.</p>
        <div class="mt-[1.4rem] flex flex-wrap gap-[0.8rem]"><Button href="/" variant="green" arrow>На главную</Button><Button href="/igry/" variant="paper" icon="gamepad">Игры</Button></div>
      </div>
      <div class="relative pt-[3rem]">
        <SpeechBubble phrase={phrases.question} tail="down-left" class="absolute top-0 left-[8%] max-w-[13rem] rotate-[-2deg]" />
        <KitImage name="girl-waving" eager sizes="(min-width: 640px) 30vw, 70vw" alt="Девочка с яблоком машет рукой" class="mx-auto w-[80%] max-w-[24rem]" />
      </div>
    </div>
  </Scene>
</BaseLayout>
