---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Button from '@/components/Button.astro'
import VideoCard from '@/components/VideoCard.astro'
import VideoEpisode from '@/components/VideoEpisode.astro'
import { videos, type Video } from '@/data/videos'
import { breadcrumbSchema, videoSchema } from '@/lib/seo'
import { typo } from '@/lib/typo'
export const getStaticPaths = (() => videos.map((video) => ({ params: { id: video.id }, props: { video } }))) satisfies GetStaticPaths
interface Props { video: Video }
const { video } = Astro.props
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'Мультфильмы', href: '/multfilmy/' }, { name: video.title, href: `/multfilmy/${video.id}/` }]
---
<BaseLayout title={`${video.title} — мультфильм о еде для детей`} description={video.text} image={video.poster} schema={[videoSchema(video), breadcrumbSchema(crumbs)]}>
  <section class="mx-auto max-w-5xl px-5 py-8 md:px-8 md:py-12">
    <Breadcrumbs items={crumbs} />
    <p class="mb-3 text-sm font-bold text-protein">Мультфильм · {video.length} · 8–12 лет</p>
    <h1 class="mb-6 font-display text-4xl leading-tight font-bold md:text-5xl">{video.title}</h1>
    <VideoCard video={video} playable />
    <div class="mt-10 grid gap-8 md:grid-cols-[1.5fr_1fr]">
      <div><h2 class="font-display text-2xl font-bold">О чём эта история</h2><div class="mt-4 space-y-4 text-lg leading-relaxed">{video.story.map((paragraph) => <p>{typo(paragraph)}</p>)}</div><h2 class="mt-8 font-display text-2xl font-bold">Обсудим после просмотра?</h2><p class="mt-3 text-lg">{typo(video.question)}</p><a href="/o-proekte/#sources" class="mt-5 inline-block text-sm text-water underline underline-offset-4">Пояснения и источники для взрослых</a></div>
      <aside class="rounded-2xl bg-mint/25 p-6"><p class="text-xs font-extrabold tracking-wider text-forest uppercase">Теперь попробуй сам</p><h2 class="mt-3 font-display text-2xl font-bold">{video.gameTitle}</h2><p class="mt-3 text-base leading-relaxed">Перенеси открытие из мультфильма в игру. Если ошибёшься, герои подскажут.</p><Button href={video.gameHref} variant="green" class="mt-5">Играть →</Button></aside>
    </div>
    <div class="mt-12 border-t border-ink/15 pt-8"><h2 class="mb-5 font-display text-2xl font-bold">Ещё мультфильмы</h2><div class="grid gap-4 md:grid-cols-2">{videos.filter((item) => item.id !== video.id).map((item) => <VideoEpisode video={item} />)}</div></div>
  </section>
</BaseLayout>
