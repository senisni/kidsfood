---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import VideoCard from '@/components/VideoCard.astro'
import { videos } from '@/data/videos'
import { absoluteUrl, breadcrumbSchema, videoSchema } from '@/lib/seo'
const crumbs = [{ name: 'Главная', href: '/' }, { name: 'Мультфильмы', href: '/multfilmy/' }]
---
<BaseLayout title="Мультфильмы о еде для детей 8–12 лет — Три друга на тарелке" description="Три коротких мультфильма о разнообразной еде, клетчатке и сытости. Смотреть бесплатно: 68, 27 и 26 секунд. После каждого — игра по теме." schema={[breadcrumbSchema(crumbs), { '@type': 'ItemList', itemListElement: videos.map((video, index) => ({ '@type': 'ListItem', position: index + 1, url: absoluteUrl(`/multfilmy/${video.id}/`), item: videoSchema(video) })) }]}>
  <section class="mx-auto max-w-7xl px-5 py-10 md:px-8 md:py-14"><Breadcrumbs items={crumbs} /><h1 class="max-w-3xl font-display text-4xl leading-tight font-bold md:text-5xl">Мультфильмы о еде для детей</h1><p class="mt-5 max-w-2xl text-xl leading-relaxed">Короткие бумажные истории для детей 8–12 лет. Начни с трёх друзей, а потом загляни в сад в животе и на семейный ужин.</p><div class="mt-9 grid items-start gap-8 md:grid-cols-2 lg:grid-cols-3">{videos.map((video, index) => <VideoCard video={video} large={index === 0} />)}</div></section>
</BaseLayout>
