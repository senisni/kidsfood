---
// Секция с широким бумажным фоном. Картинка не шире 150rem (2400 px): на очень широких
// мониторах края плавно уходят в цвет секции (fill), фигуры не растягиваются.
import { twMerge } from 'tailwind-merge'
import { kitImage } from '@/data/kit'

interface Props {
  background: string
  fill: string
  position?: string
  eager?: boolean
  as?: 'section' | 'div' | 'footer'
  class?: string
  [key: string]: unknown
}

const { background, fill, position = 'object-center', eager = false, as: Tag = 'section', class: className, ...rest } = Astro.props
const image = kitImage(background)
---

<Tag class:list={[twMerge('relative isolate overflow-hidden', fill, className)]} {...rest}>
  <div aria-hidden="true" class="absolute inset-y-0 left-1/2 -z-10 w-full max-w-[150rem] -translate-x-1/2 min-[150rem]:mask-x-from-90%">
    <img src={image.src} srcset={image.srcset} sizes="100vw" width={image.width} height={image.height} alt="" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" class:list={['size-full object-cover', position]} />
  </div>
  <slot />
</Tag>
