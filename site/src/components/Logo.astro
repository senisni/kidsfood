---
// Знак и название проекта: шапка, подвал
import { twMerge } from 'tailwind-merge'
import KitImage from '@/components/KitImage.astro'

interface Props {
  tone?: 'ink' | 'paper'
  class?: string
  [key: string]: unknown
}

const { tone = 'ink', class: className, ...rest } = Astro.props
---

<a href="/" aria-label="Три друга на тарелке — главная" class:list={[twMerge('inline-flex shrink-0 items-center gap-[0.6rem] font-display text-[1.6rem] leading-none font-black', tone === 'ink' ? 'text-forest-deep' : 'text-paper', className)]} {...rest}>
  <KitImage name="logo-mark" sizes="4rem" eager class="size-[3rem] drop-shadow-[0_0.15rem_0.2rem_rgb(60_40_10/0.2)]" />
  Три друга
</a>
