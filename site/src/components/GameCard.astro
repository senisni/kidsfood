---
// Карточка игры: номер на карте, вырезка, название и кнопка «Играть»
import { twMerge } from 'tailwind-merge'
import Icon from '@/components/Icon.astro'
import KitImage from '@/components/KitImage.astro'
import type { Game } from '@/data/games'
import { typo } from '@/lib/typo'

interface Props {
  game: Game
  number: number
  class?: string
  [key: string]: unknown
}

const { game, number, class: className, ...rest } = Astro.props
---

<a href={game.href} class:list={[twMerge('group relative flex flex-col items-center rounded-[1.8rem] bg-paper/95 px-[0.9rem] pt-[1.1rem] pb-[1rem] text-center shadow-paper-lg ring-2 ring-cream-deep/70 transition hover:-translate-y-1 hover:rotate-[-0.6deg]', className)]} {...rest}>
  <span aria-hidden="true" class="absolute -top-[0.6rem] -left-[0.4rem] grid size-[2.2rem] place-items-center rounded-full bg-forest font-display text-[1.05rem] font-black text-paper shadow-paper ring-[0.2rem] ring-paper">{number}</span>
  <KitImage name={game.image} sizes="(min-width: 640px) 14rem, 45vw" class="aspect-square w-[82%] drop-shadow-[0_0.3rem_0.3rem_rgb(60_40_10/0.18)] transition group-hover:scale-105" />
  <h3 class="mt-[0.3rem] font-display text-[1.1rem] leading-tight font-black text-ink">{typo(game.title)}</h3>
  <p class="mt-[0.3rem] mb-[0.8rem] text-[0.85rem] leading-snug text-ink/70">{typo(game.text)}</p>
  <span class="mt-auto inline-flex items-center gap-[0.4rem] rounded-full bg-terracotta px-[1rem] py-[0.35rem] pt-[0.4rem] font-display text-[0.95rem] font-extrabold text-paper shadow-[0_0.2rem_0_#97401f]">Играть <Icon name="arrow" class="transition group-hover:translate-x-1" /></span>
</a>
