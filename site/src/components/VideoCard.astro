---
// Мультфильм карточкой (кадр + описание) или плеером в деревянной раме (playable)
import { twMerge } from 'tailwind-merge'
import VideoTile from '@/components/VideoTile.astro'
import type { Video } from '@/data/videos'
import { typo } from '@/lib/typo'
interface Props { video: Video; large?: boolean; playable?: boolean; class?: string; [key: string]: unknown }
const { video, large = false, playable = false, class: className, ...rest } = Astro.props
const href = `/multfilmy/${video.id}/`
---
<article class:list={[twMerge('min-w-0', className)]} {...rest}>
  {playable
    ? <div class="rounded-[1.2rem] bg-wood p-[0.55rem] shadow-[0_1rem_2rem_rgb(0_0_0/0.3)] ring-[0.3rem] ring-wood-dark sm:p-[0.8rem]"><video id="video" class="aspect-video w-full rounded-[0.8rem] bg-night" controls playsinline preload="metadata" poster={video.poster} aria-label={video.title}><source src={video.src} type="video/mp4" /><a href={video.src}>Скачать мультфильм</a></video></div>
    : <><VideoTile video={video} caption={false} class="rounded-[1.4rem] shadow-paper-lg ring-[0.3rem] ring-paper" /><div class="pt-[1rem]"><p class="text-[0.9rem] font-extrabold text-terracotta">{large ? `Начни с этой истории · ${video.length}` : video.length}</p><h2 class:list={['mt-[0.2rem] font-display leading-tight font-black text-forest-deep', large ? 'text-[1.8rem]' : 'text-[1.4rem]']}><a href={href} class="underline-offset-4 hover:underline">{video.title}</a></h2><p class="mt-[0.4rem] text-[1rem] leading-relaxed text-ink/80">{typo(video.text)}</p></div></>}
</article>
