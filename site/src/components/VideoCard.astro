---
import { twMerge } from 'tailwind-merge'
import type { Video } from '@/data/videos'
import { typo } from '@/lib/typo'
interface Props { video: Video; large?: boolean; playable?: boolean; class?: string; [key: string]: unknown }
const { video, large = false, playable = false, class: className, ...rest } = Astro.props
const href = `/multfilmy/${video.id}/`
---
<article class:list={[twMerge('min-w-0', className)]} {...rest}>
  {playable ? <video id="video" class="aspect-video w-full rounded-2xl bg-ink" controls playsinline preload="metadata" poster={video.poster} aria-label={video.title}><source src={video.src} type="video/mp4" /><a href={video.src}>Скачать мультфильм</a></video> : <a href={href} aria-label={`Смотреть «${video.title}», ${video.length}`} class="group relative block overflow-hidden rounded-2xl bg-ink"><img src={video.poster} alt={`Кадр мультфильма «${video.title}»`} width="1280" height="720" loading="lazy" class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.02]" /><span aria-hidden="true" class="absolute inset-0 grid place-items-center"><span class="grid size-14 place-items-center rounded-full bg-paper text-xl text-forest shadow-paper">▶</span></span><span class="absolute right-3 bottom-3 rounded-lg bg-ink/85 px-3 py-1 text-sm font-bold text-paper">{video.length}</span></a>}
  <div class="pt-4"><p class="mb-1 text-xs font-extrabold tracking-wider text-protein uppercase">{large ? 'Начни с этой истории' : video.length}</p><h3 class:list={['font-display font-bold', large ? 'text-3xl' : 'text-2xl']}><a href={href} class="underline-offset-4 hover:underline">{video.title}</a></h3><p class="mt-2 max-w-2xl text-base leading-relaxed text-ink/80">{typo(video.text)}</p></div>
</article>
