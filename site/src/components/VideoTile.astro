---
// Превью мультфильма: постер, кнопка «смотреть», название и длительность поверх кадра.
// size="screen" — большой экран кинотеатра, "tile" — карточка эпизода; caption={false} — только кадр и кнопка
import { twMerge } from 'tailwind-merge'
import Icon from '@/components/Icon.astro'
import type { Video } from '@/data/videos'

interface Props {
  video: Video
  size?: 'screen' | 'tile'
  caption?: boolean
  class?: string
  [key: string]: unknown
}

const { video, size = 'tile', caption = true, class: className, ...rest } = Astro.props
const screen = size === 'screen' || !caption
---

<a href={`/multfilmy/${video.id}/`} class:list={[twMerge('group relative block overflow-hidden bg-night', screen ? 'rounded-[0.8rem]' : 'rounded-[1.2rem] ring-[0.3rem] ring-paper/90 shadow-paper-lg', className)]} {...rest}>
  <img src={video.poster} alt={`Кадр мультфильма «${video.title}»`} width="1280" height="720" loading="lazy" decoding="async" class="aspect-video w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
  {caption && <span aria-hidden="true" class="absolute inset-0 bg-linear-to-t from-ink/75 via-ink/5 to-transparent"></span>}
  {screen && <span aria-hidden="true" class="absolute inset-0 grid place-items-center"><span class="grid size-[3.6rem] sm:size-[5rem] place-items-center rounded-full bg-ink/45 text-paper ring-[0.25rem] ring-paper backdrop-blur-sm transition group-hover:scale-110 group-hover:bg-terracotta"><Icon name="play" class="size-[1.8rem] translate-x-[0.15rem] sm:size-[2.4rem]" /></span></span>}
  {caption && <span class:list={['absolute inset-x-0 bottom-0 flex items-center gap-[0.7rem] text-paper', screen ? 'p-[0.8rem] sm:p-[1.2rem]' : 'p-[0.8rem]']}>
    {!screen && <span aria-hidden="true" class="grid size-[2.3rem] shrink-0 place-items-center rounded-full bg-paper text-ink transition group-hover:bg-terracotta group-hover:text-paper"><Icon name="play" class="size-[1.2rem] translate-x-[0.08rem]" /></span>}
    <span class="min-w-0 text-left">
      <span class:list={['block font-display leading-tight font-black', screen ? 'text-[1.3rem] sm:text-[1.8rem]' : 'text-[1.1rem]']}>{video.title}</span>
      <span class="mt-[0.15rem] flex items-center gap-[0.3rem] text-[0.85rem] font-bold text-paper/85"><Icon name="clock" class="size-[0.95rem]" />{video.length}</span>
    </span>
  </span>}
</a>
