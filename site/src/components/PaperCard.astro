---
// Бумажная карточка: кремовый лист на смещённой цветной подложке.
// class — для содержимого листа (отступы, flex), wrapperClass — для внешней обёртки (сетка, ширина).
import { twMerge } from 'tailwind-merge'

interface Props {
  backing?: string
  as?: 'div' | 'article' | 'a' | 'li'
  class?: string
  wrapperClass?: string
  flat?: boolean
  [key: string]: unknown
}

const { backing = 'bg-sand', as: Tag = 'div', class: className, wrapperClass, flat = false, ...rest } = Astro.props
---

<Tag class:list={[twMerge('group/card relative block', wrapperClass)]} {...rest}>
  {!flat && <span aria-hidden="true" class:list={['absolute inset-0 -translate-x-1 translate-y-1 -rotate-[0.3deg] rounded-2xl', backing]}></span>}
  <div class:list={[twMerge('relative h-full rounded-2xl bg-paper shadow-paper', className)]}>
    <slot />
  </div>
</Tag>
