---
import { twMerge } from 'tailwind-merge'
import PaperCard from '@/components/PaperCard.astro'
import Tag from '@/components/Tag.astro'
import DishParts from '@/components/DishParts.astro'
import DishSteps from '@/components/DishSteps.astro'
import { typo } from '@/lib/typo'
import { dishHref, mealNames, type Dish } from '@/data/dishes'
interface Props { dish: Dish; compact?: boolean; class?: string; [key: string]: unknown }
const { dish, compact = false, class: className, ...rest } = Astro.props
const meal = mealNames[dish.meal]
const href = dishHref(dish)
---
<PaperCard as="article" backing="bg-cream-deep" flat class={twMerge('flex flex-col p-5', className)} id={dish.id} {...rest}>
  <p class="mb-2 text-xs font-extrabold tracking-wider text-protein uppercase">{meal}</p>
  <h3 class="font-display text-2xl leading-tight font-bold"><a href={href} class="decoration-forest/40 underline-offset-4 hover:underline">{typo(dish.title)}</a></h3>
  {dish.sprite && <a href={href} aria-label={`Рецепт: ${dish.title}`} class="my-3 block"><img src={dish.sprite} alt={dish.title} loading="lazy" decoding="async" width="320" height="240" class="mx-auto aspect-[4/3] w-full max-w-60 object-contain" /></a>}
  {!compact && <DishParts dish={dish} />}
  {compact && <p class="mb-4 text-base leading-relaxed text-ink/75">{typo(`${dish.veg}; ${dish.grain}; ${dish.protein}.`)}</p>}
  <div class="mt-auto flex flex-wrap gap-2 pt-4">{dish.tags.includes('ice') && <Tag kind="ice">Можно заморозить</Tag>}</div>
  {!compact && <details class="group mt-4 border-t border-ink/10 pt-3"><summary class="cursor-pointer font-display text-lg font-bold text-forest">Как готовить</summary><div class="mt-3"><DishSteps steps={dish.how} /></div></details>}
  <a href={href} class="mt-4 self-start font-bold text-forest underline underline-offset-4">{compact ? 'Открыть рецепт' : 'Рецепт отдельной страницей'} <span aria-hidden="true">→</span></a>
</PaperCard>
