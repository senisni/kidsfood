---
// Блюдо семейного меню: картинка, три друга, метки и «как готовить» в раскрывашке
import { twMerge } from 'tailwind-merge'

import PaperCard from '@/components/PaperCard.astro'
import Tag from '@/components/Tag.astro'
import { friends, friendTone } from '@/data/friends'
import { typo } from '@/lib/typo'

export interface Dish {
  id: string
  meal: 'B' | 'L' | 'D'
  title: string
  veg: string
  grain: string
  protein: string
  tags: string[]
  time: string
  how: string[]
  sprite: string | null
}

interface Props {
  dish: Dish
  compact?: boolean
  class?: string
  [key: string]: unknown
}

const { dish, compact = false, class: className, ...rest } = Astro.props
const parts = { veg: dish.veg, grain: dish.grain, protein: dish.protein }
const meal = { B: 'Завтрак', L: 'Обед', D: 'Ужин' }[dish.meal]
---

<PaperCard as="article" backing="bg-cream-deep" class={twMerge('flex flex-col p-5', className)} id={dish.id} {...rest}>
  <p class="font-display text-sm font-bold text-protein">{meal}</p>
  <h3 class="font-display text-2xl leading-tight font-bold">{typo(dish.title)}</h3>
  {dish.sprite && <img src={dish.sprite} alt={dish.title} loading="lazy" decoding="async" class="mx-auto my-3 aspect-[5/4] w-full max-w-64 object-contain drop-shadow-[0.35rem_0.55rem_0.4rem_rgb(60_40_10/0.28)]" />}
  <dl class="flex flex-col gap-1 text-base">
    {
      friends.map((friend) => (
        <div class="flex gap-2">
          <dt class:list={['w-36 shrink-0 font-display font-bold', friendTone[friend.id].text]}>{friend.name}</dt>
          <dd>{typo(parts[friend.id])}</dd>
        </div>
      ))
    }
  </dl>
  <div class="mt-3 flex flex-wrap gap-2">
    {dish.tags.includes('ice') && <Tag kind="ice">❄ можно заморозить</Tag>}
    {dish.tags.includes('fr') && <Tag kind="fr">3–4 дня в холодильнике</Tag>}
    <Tag kind="time">⏱ {dish.time}</Tag>
  </div>
  {
    !compact && (
      <details class="group mt-3">
        <summary class="cursor-pointer font-display text-lg font-bold text-forest marker:text-forest">Как готовить</summary>
        <div class="mt-2 flex flex-col gap-2 text-base leading-relaxed [&_em]:font-extrabold [&_em]:not-italic" set:html={dish.how.map((step) => `<p>${typo(step)}</p>`).join('')} />
      </details>
    )
  }
</PaperCard>
