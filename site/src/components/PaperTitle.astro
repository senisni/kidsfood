---
// Заголовок из бумажных букв: каждая буква своего цвета и падает с задержкой
import { twMerge } from 'tailwind-merge'

import { typo } from '@/lib/typo'

interface Props {
  text: string
  as?: 'h1' | 'h2' | 'p'
  class?: string
  [key: string]: unknown
}

const { text, as: Tag = 'h1', class: className, ...rest } = Astro.props
const colors = ['text-protein', 'text-grain', 'text-forest', 'text-water']
// предлоги приклеены к следующему слову неразрывным пробелом — не остаются в конце строки
const words = typo(text).split(' ')
let index = 0
---

<Tag class:list={[twMerge('font-display font-bold', className)]} aria-label={text} {...rest}>
  {
    words.map((word) => (
      <span class="mr-[0.28em] inline-block whitespace-nowrap last:mr-0" aria-hidden="true">
        {[...word].map((letter) => {
          const current = index++
          return (
            <span
              class:list={['inline-block animate-drop [text-shadow:-0.2rem_-0.2rem_0_#fbf6e8,0.2rem_-0.2rem_0_#fbf6e8,-0.2rem_0.2rem_0_#fbf6e8,0.2rem_0.2rem_0_#fbf6e8,0.4rem_0.6rem_0.5rem_rgb(60_40_10/0.25)]', colors[current % colors.length]]}
              style={`animation-delay:${current * 0.045}s; rotate:${((current * 37) % 9) - 4}deg`}
            >
              {letter}
            </span>
          )
        })}
      </span>
    ))
  }
</Tag>
