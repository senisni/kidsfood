---
// Общая часть <head>: мета для поиска и соцсетей, JSON-LD, иконки, счётчик. Используют BaseLayout и GameLayout.
import { metrikaSnippet } from '@/data/metrika'
import { absoluteUrl, serializeSchema, siteName, siteUrl } from '@/lib/seo'

interface Props {
  title: string
  description: string
  image?: string
  noindex?: boolean
  schema?: Record<string, unknown>[]
  viewport?: string
}
const { title, description, image = '/img/social.jpg', noindex = false, schema = [], viewport = 'width=device-width, initial-scale=1' } = Astro.props
const canonical = absoluteUrl(noindex ? '/404.html' : Astro.url.pathname)
const graph = [
  { '@type': 'WebSite', '@id': `${siteUrl}/#website`, name: siteName, url: `${siteUrl}/`, inLanguage: 'ru' },
  { '@type': 'WebPage', '@id': `${canonical}#page`, url: canonical, name: title, description, inLanguage: 'ru', isPartOf: { '@id': `${siteUrl}/#website` }, primaryImageOfPage: { '@type': 'ImageObject', url: absoluteUrl(image) } },
  ...schema,
]
---
<meta charset="utf-8" />
<meta name="viewport" content={viewport} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-video-preview:-1'} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteUrl(image)} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteUrl(image)} />
<meta name="theme-color" content="#f8f3e7" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script type="application/ld+json" set:html={serializeSchema({ '@context': 'https://schema.org', '@graph': graph })} />
<Fragment set:html={metrikaSnippet} />
