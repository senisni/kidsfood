---
import { twMerge } from 'tailwind-merge'
import Food from '@/components/Food.astro'
import { friendTone, type Friend } from '@/data/friends'
import { typo } from '@/lib/typo'
interface Props { friend: Friend; class?: string; [key: string]: unknown }
const { friend, class: className, ...rest } = Astro.props
const tone = friendTone[friend.id]
---
<article class:list={[twMerge('rounded-2xl p-5', tone.soft, className)]} {...rest}>
  <div class="mb-5 flex h-24 items-center justify-start gap-2" aria-hidden="true">
    {friend.foods.map((id) => <Food id={id} imgClass="size-20" />)}
  </div>
  <h3 class="font-display text-2xl font-bold md:text-3xl">{friend.name}</h3>
  <p class="mt-2 text-base">{typo(friend.why)}</p>
  <p class:list={['mt-4 border-t border-ink/10 pt-3 font-display text-base font-bold', tone.text]}>{friend.share} в схеме</p>
</article>
