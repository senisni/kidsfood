---
import Icon from '@/components/Icon.astro'
import Logo from '@/components/Logo.astro'
import { nav } from '@/data/nav'
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href) && href !== '/'
---
<header class="sticky top-0 z-sticky bg-cream/95 shadow-[0_0.1rem_0_rgb(60_40_10/0.08)] backdrop-blur">
  <div class="shell flex h-[4.2rem] items-center justify-between gap-4 sm:h-[4.8rem]">
    <Logo />
    <nav aria-label="Основная навигация" class="hidden items-center gap-[0.3rem] sm:flex">{nav.map((item) => <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="rounded-full px-[1rem] py-[0.5rem] font-display text-[1.05rem] font-extrabold text-forest-deep transition hover:bg-sage/45 aria-[current=page]:bg-sage/60">{item.label}</a>)}</nav>
    <details data-mobile-nav class="relative sm:hidden">
      <summary class="grid size-[2.8rem] list-none place-items-center rounded-full bg-paper text-forest-deep shadow-paper [&::-webkit-details-marker]:hidden" aria-label="Разделы"><Icon name="menu" class="size-[1.5rem]" /></summary>
      <nav aria-label="Мобильная навигация" class="absolute right-0 mt-[0.6rem] flex w-[15rem] flex-col rounded-[1.2rem] bg-paper p-[0.5rem] shadow-paper-lg ring-2 ring-cream-deep">{nav.map((item) => <a href={item.href} class="rounded-[0.8rem] px-[1rem] py-[0.75rem] font-display text-[1.1rem] font-extrabold text-forest-deep hover:bg-cream">{item.label}</a>)}</nav>
    </details>
  </div>
</header>
<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-mobile-nav]').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false }))
  })
</script>
