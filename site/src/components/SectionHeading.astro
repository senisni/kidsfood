---
import { twMerge } from 'tailwind-merge'
import { typo } from '@/lib/typo'
interface Props { kicker?: string; title: string; text?: string; align?: 'left' | 'center'; class?: string; [key: string]: unknown }
const { kicker, title, text, align = 'center', class: className, ...rest } = Astro.props
---
<header class:list={[twMerge('mb-7 max-w-3xl', align === 'center' ? 'mx-auto text-center' : 'text-left', className)]} {...rest}>
  {kicker && <p class="mb-3 text-xs font-extrabold tracking-[0.14em] text-protein uppercase md:text-sm">{kicker}</p>}
  <h2 class="font-display text-3xl leading-tight font-bold md:text-4xl">{typo(title)}</h2>
  {text && <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink/80">{typo(text)}</p>}
</header>
