---
// Реплика героя: бумажное облачко с хвостиком, рукописный шрифт
import { twMerge } from 'tailwind-merge'

import Sprite from '@/components/Sprite.astro'
import { speakerFace, type Phrase } from '@/data/phrases'
import { typo } from '@/lib/typo'

interface Props {
  phrase: Phrase
  face?: boolean
  tail?: 'left' | 'right' | 'down' | 'down-left'
  class?: string
  [key: string]: unknown
}

const { phrase, face = false, tail = 'down', class: className, ...rest } = Astro.props
const tailPos = {
  left: '-left-[0.7rem] top-1/2 -translate-y-1/2 rotate-90',
  right: '-right-[0.7rem] top-1/2 -translate-y-1/2 -rotate-90',
  down: 'left-1/2 -bottom-[0.85rem] -translate-x-1/2',
  'down-left': 'left-[22%] -bottom-[0.85rem] rotate-[18deg]',
}[tail]
---

<div class:list={[twMerge('flex items-center gap-3', className)]} {...rest}>
  {face && <Sprite name={speakerFace[phrase.who]} alt="" class:list={['size-14 shrink-0 rounded-full border-4 bg-paper object-cover object-top', phrase.who === 'girl' ? 'border-pink' : 'border-mint']} />}
 <p class="relative rounded-[1.6rem] bg-paper px-[1.3rem] py-[0.8rem] text-center font-hand text-[1.15rem] font-bold text-ink shadow-paper-lg ring-1 ring-ink/10">
    <span aria-hidden="true" class:list={['absolute size-0 border-x-[0.6rem] border-t-[0.95rem] border-x-transparent border-t-paper', tailPos]}></span>
  {typo(phrase.text)}
  </p>
</div>
