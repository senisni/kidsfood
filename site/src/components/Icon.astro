---
// Простые иконки линией: цвет — currentColor, размер — size-* у вызова
import { twMerge } from 'tailwind-merge'
import { iconPaths, type IconName } from '@/data/icons'

interface Props {
  name: IconName
  class?: string
  [key: string]: unknown
}

const { name, class: className, ...rest } = Astro.props
---

<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class:list={[twMerge('size-[1.2em] shrink-0', className)]} {...rest}><Fragment set:html={iconPaths[name]} /></svg>
