---
// Неровный бумажный край внутри секции: bottom — снизу, цветом следующей секции; top — сверху, цветом предыдущей.
import { twMerge } from 'tailwind-merge'

interface Props {
  side?: 'top' | 'bottom'
  class?: string
  [key: string]: unknown
}

const { side = 'bottom', class: className, ...rest } = Astro.props
---

<svg
  aria-hidden="true"
  viewBox="0 0 1440 48"
  preserveAspectRatio="none"
  class:list={[twMerge('pointer-events-none absolute inset-x-0 z-20 h-[1.6rem] w-full drop-shadow-[0_-0.15rem_0.15rem_rgb(60_40_10/0.12)] sm:h-[2.4rem]', side === 'bottom' ? '-bottom-px' : '-top-px rotate-180', className)]}
  {...rest}
>
  <path fill="currentColor" d="M0 22 C90 8 170 30 260 20 S430 4 520 18 700 34 800 20 980 6 1080 18 1260 32 1350 16 1440 14 V48 H0 Z" />
</svg>
