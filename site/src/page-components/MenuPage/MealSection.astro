---
import DishCard from '@/components/DishCard.astro'
import type { Dish } from '@/data/dishes'
import SectionHeading from '@/components/SectionHeading.astro'

interface Props {
  anchor: string
  title: string
  text: string
  dishes: Dish[]
}

const { anchor, title, text, dishes } = Astro.props
---

<section id={anchor} class="shell scroll-mt-[5rem] py-[2.6rem]">
  <SectionHeading title={title} text={text} />
  <div class="grid gap-[1.4rem] sm:grid-cols-2 lg:grid-cols-3">
    {dishes.map((dish) => <DishCard dish={dish} />)}
  </div>
</section>
