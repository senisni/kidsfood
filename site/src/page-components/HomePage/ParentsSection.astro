---
import FactCard from '@/components/FactCard.astro'
import Button from '@/components/Button.astro'
import { facts } from '@/data/facts'
interface Props { full?: boolean }
const { full = false } = Astro.props
---
<section id="parents" class="mx-auto grid max-w-7xl scroll-mt-24 gap-8 px-5 py-12 md:px-8 md:py-16 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
  <div><p class="mb-3 text-xs font-extrabold tracking-[0.14em] text-protein uppercase">Родителям и учителям</p><h2 class="font-display text-3xl leading-tight font-bold md:text-4xl">Говорим о еде<br />спокойно и с интересом</h2><p class="mt-5 max-w-md text-lg leading-relaxed text-ink/80">Вместе смотреть, пробовать, обсуждать. Без подсчёта калорий, ярлыков «плохая еда» и требования доесть.</p>{!full && <Button href="/o-proekte/" variant="ghost" class="mt-6 text-base">О проекте и источниках →</Button>}</div>
  <div>{facts.map((fact) => <FactCard fact={fact} />)}</div>
</section>
