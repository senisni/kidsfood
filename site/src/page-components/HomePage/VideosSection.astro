---
import SectionHeading from '@/components/SectionHeading.astro'
import VideoCard from '@/components/VideoCard.astro'
import VideoEpisode from '@/components/VideoEpisode.astro'
import { videos } from '@/data/videos'
const [main, ...episodes] = videos
---
<section id="videos" class="scroll-mt-24 bg-paper py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading kicker="Смотрим" title="Одна история. Много открытий." text="Завтрак, школа и ужин — в одном мультфильме. А ещё две короткие истории о клетчатке и сытости." align="left" />
    <div class="grid items-start gap-7 lg:grid-cols-[1.6fr_1fr]">
      <VideoCard video={main} large />
      <div class="grid gap-4"><p class="font-display text-lg font-bold">Ещё две истории</p>{episodes.map((video) => <VideoEpisode video={video} />)}<details class="mt-2 border-t border-ink/15 pt-4"><summary class="font-bold">Если смотрите вместе</summary><p class="mt-3 text-base leading-relaxed text-ink/75">Остановитесь на вопросе и дайте ребёнку ответить раньше героев. После просмотра можно выбрать игру по теме.</p></details></div>
    </div>
  </div>
</section>
