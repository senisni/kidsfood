---
import GameCard from '@/components/GameCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import SpeechBubble from '@/components/SpeechBubble.astro'
import { games } from '@/data/games'
import { phrases } from '@/data/phrases'
---

<section id="games" class="mx-auto max-w-7xl scroll-mt-20 px-4 py-20 md:px-6">
  <SectionHeading kicker="Играть" title="Семь игр" text="Перетаскивай еду, отвечай и проверяй себя. Ошибка — не проигрыш: герой объяснит и подскажет." />
  <SpeechBubble phrase={phrases.games} face tail="left" class="mx-auto mb-10 w-fit" />
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {games.map((game, index) => <GameCard game={game} number={index + 1} />)}
  </div>
  <p class="mt-8 text-center text-base opacity-75">Лучше играть на компьютере или планшете в горизонтальном положении.</p>
</section>
