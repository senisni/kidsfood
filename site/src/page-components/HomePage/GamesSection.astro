---
import GameCard from '@/components/GameCard.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import { games } from '@/data/games'
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props
const [first, ...others] = games
---
<section id="games" class="scroll-mt-24 bg-sky/45 py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading kicker="Пробуем сами" title={standalone ? 'Игры о еде для детей' : 'Во что поиграем?'} text="Собирай, находи и пробуй. Ошибаться можно: герои объяснят и подскажут." align="left" />
    <p class="mb-6 flex items-start gap-2 text-sm text-ink/75"><span aria-hidden="true">↔</span> Для игр удобнее компьютер или планшет с широким экраном. На телефоне поверни экран горизонтально.</p>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <GameCard game={first} featured wrapperClass="sm:col-span-2 lg:col-span-1 lg:row-span-2" />
      {others.map((game) => <GameCard game={game} />)}
    </div>
  </div>
</section>
