---
import GameCard from '@/components/GameCard.astro'
import KitImage from '@/components/KitImage.astro'
import { games } from '@/data/games'
import { typo } from '@/lib/typo'

// standalone — отдельная страница /igry/: заголовок h1
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props
const Heading = standalone ? 'h1' : 'h2'
const [first, ...others] = games
---
<section id="games" aria-labelledby="games-title" class="relative scroll-mt-[5rem] overflow-hidden bg-cream py-[3rem] sm:py-[4rem]">
  <div aria-hidden="true" class="stage">
    <KitImage name="foliage-right" sizes="16rem" class="absolute -top-[2rem] -right-[2.5rem] w-[8rem] -scale-y-100 sm:w-[12rem]" />
    <KitImage name="foliage-left" sizes="16rem" class="absolute -bottom-[2rem] -left-[2.5rem] w-[8rem] sm:w-[12rem]" />
  </div>
  <div class="shell relative">
    <div class="flex flex-wrap items-end justify-between gap-x-[2rem] gap-y-[0.6rem]">
      <Heading id="games-title" class="font-display text-[2.5rem] leading-[1] font-black text-forest-deep sm:text-[3.3rem]">{standalone ? 'Игры о еде для детей' : 'Пробуем сами'}</Heading>
      <p class="relative -rotate-[3deg] pr-[2.4rem] font-hand text-[1.25rem] leading-snug text-forest-deep sm:text-[1.4rem]">{typo('Ошибаться можно — герои подскажут')}<span aria-hidden="true" class="absolute top-1/2 right-0 flex -translate-y-1/2 flex-col gap-[0.3rem]"><span class="block h-[0.3rem] w-[1.6rem] -rotate-[20deg] rounded-full bg-sand"></span><span class="block h-[0.3rem] w-[1.8rem] rounded-full bg-sand"></span><span class="block h-[0.3rem] w-[1.6rem] rotate-[20deg] rounded-full bg-sand"></span></span></p>
    </div>
    <p class="mt-[0.5rem] max-w-[40rem] text-[0.95rem] text-ink/70">{typo('Семь бесплатных игр без регистрации. На телефоне удобнее играть, повернув экран горизонтально.')}</p>
    <div class="mt-[1.8rem] grid grid-cols-2 gap-[0.8rem] sm:grid-cols-3 sm:gap-[1.2rem] lg:grid-cols-[1.35fr_1fr_1fr_1fr]">
      <GameCard game={first} featured class="col-span-2 sm:col-span-3 lg:col-span-1 lg:row-span-2" />
      <ul class="contents">{others.map((game) => <li class="flex"><GameCard game={game} class="w-full" /></li>)}</ul>
    </div>
  </div>
</section>
