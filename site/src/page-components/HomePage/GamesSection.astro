---
import GameCard from '@/components/GameCard.astro'
import KitImage from '@/components/KitImage.astro'
import Scene from '@/components/Scene.astro'
import { games } from '@/data/games'
import { typo } from '@/lib/typo'

// standalone — отдельная страница /igry/: заголовок h1 и край к подвалу
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props
const Heading = standalone ? 'h1' : 'h2'
---
<Scene id="games" background="games-garden" fill="bg-sage" position="object-top" aria-labelledby="games-title" class="scroll-mt-[5rem] pt-[3rem] pb-[5rem] sm:pt-[3.6rem] sm:pb-[6rem]">
  <div class="shell relative">
    <KitImage name="girl-thinking" sizes="(min-width: 640px) 16rem, 9rem" alt="" class="absolute -top-[1.5rem] right-0 w-[7.5rem] sm:-top-[2.2rem] sm:right-[2%] sm:w-[13rem]" />
    <Heading id="games-title" class="max-w-[70%] font-display text-[2.5rem] leading-[1] font-black text-forest-deep sm:text-[3.3rem]">{standalone ? 'Игры о еде для детей' : 'Пробуем сами'}</Heading>
    <p class="mt-[0.7rem] max-w-[60%] text-[1.1rem] font-extrabold text-forest-deep/85 sm:max-w-[34rem]">{typo('Ошибаться можно — герои подскажут. Семь бесплатных игр без регистрации.')}</p>
    <p class="mt-[0.4rem] max-w-[60%] text-[0.9rem] text-ink/70 sm:max-w-none">{typo('На телефоне удобнее играть, повернув экран горизонтально.')}</p>
    <KitImage name="path-dots" sizes="70rem" alt="" class="pointer-events-none absolute inset-x-0 top-[15rem] hidden w-full opacity-90 lg:block" />
    <KitImage name="path-dots" sizes="70rem" alt="" class="pointer-events-none absolute inset-x-0 top-[33rem] hidden w-full -scale-x-100 opacity-90 lg:block" />
    <ul class="relative mt-[2.2rem] flex flex-wrap justify-center gap-x-[0.8rem] gap-y-[1.4rem] sm:gap-x-[1.4rem] sm:gap-y-[1.8rem]">
      {games.map((game, index) => <li class="flex w-[calc(50%-0.4rem)] sm:w-[13.5rem] lg:w-[15.5rem]"><GameCard game={game} number={index + 1} class="w-full" /></li>)}
    </ul>
  </div>
</Scene>
