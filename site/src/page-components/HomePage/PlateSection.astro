---
import FriendLabel from '@/components/FriendLabel.astro'
import KitImage from '@/components/KitImage.astro'
import { friends } from '@/data/friends'
import { typo } from '@/lib/typo'

// где стоит ярлык у тарелки на широком экране: овощи — слева от своей половины, крупы и белок — справа
const labelPlace = {
  veg: 'lg:top-[2%] lg:-left-[6%]',
  grain: 'lg:top-[20%] lg:-right-[8%]',
  protein: 'lg:bottom-[8%] lg:-right-[4%]',
}
---
<section id="friends" aria-labelledby="friends-title" class="relative scroll-mt-[5rem] overflow-hidden bg-cream pt-[2.4rem] pb-[4rem] sm:pt-[2.6rem] sm:pb-[4rem]">
  <div aria-hidden="true" class="stage">
<KitImage name="foliage-left" sizes="20rem" class="absolute -bottom-[2.5rem] -left-[3rem] w-[9rem] sm:w-[12rem]" />
  <KitImage name="mustard-sprig" sizes="12rem" class="absolute right-[1%] bottom-[2.5rem] hidden w-[7rem] sm:block" />
  <KitImage name="foliage-right" sizes="20rem" class="absolute -right-[2rem] -bottom-[1rem] w-[8rem] sm:w-[13rem]" />
    </div>
  <div class="shell relative grid items-center gap-[1.5rem] sm:grid-cols-2 lg:grid-cols-[0.9fr_1.3fr]">
    <div class="relative z-10">
      <h2 id="friends-title" class="font-display text-[2.6rem] leading-[1] font-black text-forest-deep sm:text-[3rem] lg:text-[3.4rem]">Кого позовём <br />на тарелку?</h2>
      <p class="mt-[1rem] max-w-[27rem] text-[1.05rem] leading-relaxed text-ink/80">{typo('Половина тарелки — овощи и фрукты, четверть — крупы и хлеб, четверть — белок. Схема одна для завтрака, обеда и ужина. Это ориентир для разнообразия, а не норма порций.')}</p>
    </div>
    <div class="relative mx-auto w-full max-w-[36rem] lg:py-[1.5rem]">
      <KitImage name="plate-three-friends" sizes="(min-width: 640px) 24rem, 75vw" alt="Тарелка: половина — огурцы, брокколи и помидоры, четверть — крупа и хлеб, четверть — рыба, яйцо и фасоль" class="mx-auto w-[78%] drop-shadow-[0_0.5rem_0.6rem_rgb(60_40_10/0.2)] sm:w-[60%] lg:w-[64%]" />
      <ul class="mt-[1.2rem] grid gap-[0.6rem] lg:mt-0 lg:block">
        {friends.map((friend) => <li class:list={['lg:absolute lg:w-[15.5rem]', labelPlace[friend.id]]}><FriendLabel friend={friend} class="h-full" /></li>)}
      </ul>
    </div>
  </div>
</section>
