---
import Button from '@/components/Button.astro'
import KitImage from '@/components/KitImage.astro'
import PaperCloud from '@/components/PaperCloud.astro'
import Scene from '@/components/Scene.astro'
import { friends } from '@/data/friends'

// парящие значки трёх друзей вокруг тарелки
// бумажные облака: место, размер и темп медленного дрейфа (у каждого свой, чтобы не плыли строем)
const clouds = [
  { place: 'top-[9%] left-[34%] w-[9rem]', drift: '[animation-duration:70s]' },
  { place: 'top-[4%] left-[58%] w-[6.5rem]', drift: '[animation-duration:90s] [animation-delay:-30s]' },
  { place: 'top-[22%] right-[12%] w-[11rem]', drift: '[animation-duration:80s] [animation-delay:-55s]' },
  { place: 'top-[38%] left-[46%] w-[5.5rem] opacity-90', drift: '[animation-duration:100s] [animation-delay:-12s]' },
]
const floaters = [
  { id: friends[0].id, place: 'top-[8%] left-[6%] w-[4.6rem]', delay: '[animation-delay:-0.4s]' },
  { id: friends[1].id, place: 'top-[2%] right-[30%] w-[3.8rem]', delay: '[animation-delay:-1.6s]' },
  { id: friends[2].id, place: 'top-[30%] right-[2%] w-[4.2rem]', delay: '[animation-delay:-2.4s]' },
]
---
<Scene background="hero-garden" mobileBackground="hero-garden-portrait" fill="bg-skyline" position="object-[50%_100%]" eager aria-labelledby="hero-title" class="pb-[2.2rem] sm:pb-[2.6rem]">
  <div aria-hidden="true" class="stage">
    <KitImage name="sun" eager sizes="8rem" class="absolute top-[1.6rem] right-[3%] hidden w-[6rem] sm:block" />
    {clouds.map((cloud) => <div class:list={['absolute hidden sm:block', cloud.place]}><PaperCloud class={`w-full animate-drift ${cloud.drift}`} /></div>)}
 </div>
  <div class="shell grid items-center gap-[0.5rem] pt-[2.2rem] sm:min-h-[36rem] sm:grid-cols-2 sm:gap-[2rem] sm:pt-[2.5rem] lg:grid-cols-[0.85fr_1.15fr]">
    <div class="relative z-10">
      <span aria-hidden="true" class="absolute -top-[1.2rem] -left-[0.4rem] flex flex-col gap-[0.35rem] sm:-left-[1.2rem]"><span class="block h-[0.35rem] w-[1.3rem] rotate-[35deg] rounded-full bg-sand"></span><span class="ml-[-0.5rem] block h-[0.35rem] w-[1.5rem] rotate-[10deg] rounded-full bg-sand"></span></span>
      <h1 id="hero-title" class="leading-[1em] font-display text-[3.4rem] font-extrabold tracking-[-0.01em] [text-shadow:0_0.18rem_0_#fffcf4,0_0.4rem_0.6rem_rgb(31_74_51/0.18)] sm:text-[4rem] lg:text-[4.9rem]">
        <span class="inline-block -rotate-[2deg] text-forest-deep">Три друга</span><br />
        <span class="whitespace-nowrap"><span class="inline-block rotate-[1deg] text-forest-deep">на</span> <span class="inline-block -rotate-[1.5deg] text-terracotta">тарелке</span></span>
      </h1>
      <p class="mt-[1.1rem] inline-block -rotate-[1.5deg] rounded-[0.3rem] bg-sand/90 px-[1rem] py-[0.4rem] text-[0.95rem] font-extrabold text-forest-deep shadow-paper sm:text-[1.25rem]">Мультфильмы и игры о еде · <span class="whitespace-nowrap">8–12 лет</span></p>
      <div class="mt-[1.6rem] flex flex-wrap items-center gap-[0.8rem]">
        <Button href="/multfilmy/film/" icon="play" iconCircle>Смотреть мультфильм</Button>
        <Button href="#games" variant="green" icon="gamepad" iconCircle>Выбрать игру</Button>
      </div>
    </div>
    <div class="relative pt-[2rem] sm:pt-[3rem]">
      <div><KitImage name="hero-family" eager sizes="(min-width: 640px) 55vw, 100vw" alt="Мальчик и девочка за столом. На тарелке овощи, крупа, хлеб и рыба, рядом яблоко и вода" class="relative w-full" /></div>
      {floaters.map((item) => <div aria-hidden="true" class:list={['absolute hidden lg:block', item.place]}><KitImage name={`friend-${item.id}`} sizes="6rem" class={`pointer-events-auto w-full animate-bob drop-shadow-[0_0.4rem_0.4rem_rgb(60_40_10/0.25)] transition duration-300 hover:scale-125 hover:rotate-12 ${item.delay}`} /></div>)}
    </div>
  </div>
</Scene>

