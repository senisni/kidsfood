---
import Button from '@/components/Button.astro'
import KitImage from '@/components/KitImage.astro'
import Scene from '@/components/Scene.astro'
import SpeechBubble from '@/components/SpeechBubble.astro'
import { phrases } from '@/data/phrases'
---
<Scene background="hero-garden" fill="bg-skyline" position="object-[50%_100%]" eager aria-labelledby="hero-title" class="pb-[2.2rem] sm:pb-[2.6rem]">
  <div aria-hidden="true" class="stage">
<KitImage name="sun" eager sizes="8rem" class="absolute top-[1.2rem] right-[1rem] w-[4.2rem] animate-bob sm:top-[1.6rem] sm:right-[3%] sm:w-[6rem]" />
    </div>
  <div class="shell grid items-center gap-[0.5rem] pt-[2.2rem] sm:min-h-[36rem] sm:grid-cols-2 lg:grid-cols-[0.85fr_1.15fr] sm:gap-[2rem] sm:pt-[2.5rem]">
    <div class="relative z-10">
      <h1 id="hero-title" class="font-display text-[3.3rem] leading-[0.95] font-black tracking-tight text-forest-deep [text-shadow:0_0.15rem_0_rgb(255_252_244/0.7)] sm:text-[4rem] lg:text-[4.8rem]">Три друга <br />на тарелке</h1>
      <p class="mt-[0.9rem] max-w-[31rem] text-[1.15rem] leading-snug font-extrabold text-forest-deep sm:text-[1.3rem]">Мультфильмы и игры о еде для детей <span class="whitespace-nowrap">8–12 лет</span></p>
      <div class="mt-[1.5rem] flex flex-col items-start gap-[0.8rem]">
        <Button href="/multfilmy/film/" icon="play">Смотреть мультфильм</Button>
        <Button href="#games" variant="green" icon="gamepad">Выбрать игру</Button>
      </div>
    </div>
    <div class="relative pt-[3.5rem] sm:pt-[4rem]">
      <KitImage name="hero-family" eager sizes="(min-width: 640px) 55vw, 100vw" alt="Мальчик и девочка за столом. На тарелке овощи, крупа, хлеб и рыба, рядом яблоко и вода" class="relative w-full" />
      <SpeechBubble phrase={phrases.heroGirl} tail="down-left" class="absolute top-0 right-[4%] max-w-[10.5rem] rotate-[-3deg] sm:right-[8%] sm:max-w-[12rem]" />
    </div>
  </div>
</Scene>
