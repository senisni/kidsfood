---
import '@/styles/global.css'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import SeoHead from '@/components/SeoHead.astro'

interface Props {
  title: string
  description: string
  image?: string
  noindex?: boolean
  schema?: Record<string, unknown>[]
}
const props = Astro.props
---
<!doctype html>
<html lang="ru">
  <head>
    <SeoHead {...props} />
    <link rel="preload" href="/shared/fonts/rubik-800-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-modal focus:rounded-xl focus:bg-paper focus:px-5 focus:py-3">К содержимому</a>
    <Header />
    <main id="content"><slot /></main>
    <Footer />
  </body>
</html>
